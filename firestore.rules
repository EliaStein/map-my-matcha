rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - profiles are private to their owner
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Cafes collection - anyone can read, signed-in users can add.
    // Updates may only touch the denormalized rating stats, which are
    // written by the review transaction in services/reviews.js.
    match /cafes/{cafeId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['averageRating', 'totalReviews', 'ratingDistribution']);
      // Stub cafes (Places-seeded placeholders) may be cleaned up by
      // signed-in users; real cafes can't be deleted from the client.
      allow delete: if request.auth != null && resource.data.isStub == true;
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
  }
}
